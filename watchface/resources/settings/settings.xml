    <setting propertyKey="@Properties.BikeTarget" title="@Strings.BikeTargetTitle">
        <settingConfig type="numeric" min="0" max="1200"/>
    </setting>
    <setting propertyKey="@Properties.RunTarget" title="@Strings.RunTargetTitle">
