import Toybox.Activity;
import Toybox.ActivityMonitor;
import Toybox.Application;
import Toybox.Graphics;
import Toybox.Lang;
import Toybox.Math;
import Toybox.System;
import Toybox.Time;
import Toybox.Time.Gregorian;
import Toybox.Weather;
import Toybox.WatchUi;

// Race Timing palette, matching the site's tokens in src/styles/global.css.
const COLOR_BG = 0x000000;
const COLOR_TRACK = 0x161B22;
const COLOR_INK = 0xF2F4F7;
const COLOR_MUTED = 0xA9B2C0;
const COLOR_FAINT = 0x7D8796;
const COLOR_ACCENT = 0xFFB020;
// Things that are off: status icons, the always-on panel outline.
const COLOR_OFF = 0x2A313B;
// The LCD panel: its fill, its border, and the unlit segments.
const COLOR_PANEL = 0x0E141B;
const COLOR_PANEL_LINE = 0x2C3644;
const COLOR_GHOST = 0x18202A;

// Swim, bike, run. These colors only ever mean the sport.
const SPORT_COLORS = [0x2EA4DC, 0xF28E42, 0x35C177];
// Default weekly targets in minutes, about the 7-hour base weeks.
const DEFAULT_TARGETS = [80, 180, 150];
const TARGET_KEYS = ["SwimTarget", "BikeTarget", "RunTarget"];

const DAY_NAMES = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"];

// Garmin's built-in scalable font faces, first match wins.
const BOLD_FACES = ["RobotoCondensedBold", "Swiss721Bold", "BionicBold"];
const REGULAR_FACES = ["RobotoCondensedRegular", "Swiss721Regular", "RobotoCondensedBold"];

// Layout is designed on the 454px Fenix 9 Pro 47mm (see the mockup) and scaled from there.
const DESIGN_SIZE = 454.0;
const RING_R = 50;

class SplitDecisionsView extends WatchUi.WatchFace {

    private var _asleep as Boolean = false;
    private var _week as TrainingWeek = new TrainingWeek();
    private var _weekLoadedMinute as Number = -1;

    // LCD segment fonts, generated by tools/make_assets.py.
    private var _segTime as WatchUi.FontResource;
    private var _segSecs as WatchUi.FontResource;
    private var _segDate as WatchUi.FontResource;
    private var _segDay as WatchUi.FontResource;
    private var _segAmPm as WatchUi.FontResource;
    // Everything else uses Garmin's built-in scalable fonts, which the watch draws smoothly at any size.
    // The bundled bitmap fonts are only a fallback.
    private var _big as Graphics.FontType;    // 48 bold: days to race day
    private var _temp as Graphics.FontType;   // 28 bold: temperature
    private var _row as Graphics.FontType;    // 26 bold: steps, battery, HR (as big as the quarter-width columns allow)
    private var _val as Graphics.FontType;    // 26 bold: distance in the sport rings
    private var _bold as Graphics.FontType;   // 22 bold: ring times, wind, the race label
    private var _small as Graphics.FontType;  // 16 regular: distance units

    // True when the scalable fonts loaded, which curved text needs.
    private var _vector as Boolean = false;

    private var _sportIcons as Array<WatchUi.BitmapResource>;
    // Steps, battery, heart.
    private var _icons as Array<WatchUi.BitmapResource>;
    // The current conditions icon, reloaded only when the condition changes.
    private var _wxCondition as Number = -1;
    private var _wxIcon as WatchUi.BitmapResource? = null;
    // Phone, do not disturb, alarm: lit, then off.
    private var _statusOn as Array<WatchUi.BitmapResource>;
    private var _statusOff as Array<WatchUi.BitmapResource>;

    // Set at the top of each onUpdate.
    private var _cx as Number = 227;
    private var _cy as Number = 227;
    private var _s as Float = 1.0;

    function initialize() {
        WatchFace.initialize();
        _segTime = WatchUi.loadResource(Rez.Fonts.SegTime) as WatchUi.FontResource;
        _segSecs = WatchUi.loadResource(Rez.Fonts.SegSecs) as WatchUi.FontResource;
        _segDate = WatchUi.loadResource(Rez.Fonts.SegDate) as WatchUi.FontResource;
        _segDay = WatchUi.loadResource(Rez.Fonts.SegDay) as WatchUi.FontResource;
        _segAmPm = WatchUi.loadResource(Rez.Fonts.SegAmPm) as WatchUi.FontResource;
        _big = textFont(BOLD_FACES, 48, Rez.Fonts.NumData);
        _temp = textFont(BOLD_FACES, 28, Rez.Fonts.NumData);
        _row = textFont(BOLD_FACES, 26, Rez.Fonts.NumDetail);
        _val = textFont(BOLD_FACES, 26, Rez.Fonts.NumDetail);
        _bold = textFont(BOLD_FACES, 22, Rez.Fonts.MonoBold);
        _small = textFont(REGULAR_FACES, 16, Rez.Fonts.MonoLabel);
        _sportIcons = [
            WatchUi.loadResource(Rez.Drawables.IconSwim) as WatchUi.BitmapResource,
            WatchUi.loadResource(Rez.Drawables.IconBike) as WatchUi.BitmapResource,
            WatchUi.loadResource(Rez.Drawables.IconRun) as WatchUi.BitmapResource
        ] as Array<WatchUi.BitmapResource>;
        _icons = [
            WatchUi.loadResource(Rez.Drawables.IconSteps) as WatchUi.BitmapResource,
            WatchUi.loadResource(Rez.Drawables.IconBattery) as WatchUi.BitmapResource,
            WatchUi.loadResource(Rez.Drawables.IconHeart) as WatchUi.BitmapResource
        ] as Array<WatchUi.BitmapResource>;
        _statusOn = [
            WatchUi.loadResource(Rez.Drawables.IconBt) as WatchUi.BitmapResource,
            WatchUi.loadResource(Rez.Drawables.IconDnd) as WatchUi.BitmapResource,
            WatchUi.loadResource(Rez.Drawables.IconAlarm) as WatchUi.BitmapResource
        ] as Array<WatchUi.BitmapResource>;
        _statusOff = [
            WatchUi.loadResource(Rez.Drawables.IconBtOff) as WatchUi.BitmapResource,
            WatchUi.loadResource(Rez.Drawables.IconDndOff) as WatchUi.BitmapResource,
            WatchUi.loadResource(Rez.Drawables.IconAlarmOff) as WatchUi.BitmapResource
        ] as Array<WatchUi.BitmapResource>;
    }

    function onUpdate(dc as Graphics.Dc) as Void {
        var w = dc.getWidth();
        var h = dc.getHeight();
        _s = w / DESIGN_SIZE;

        var settings = System.getDeviceSettings();
        var burnIn = (settings has :requiresBurnInProtection) && settings.requiresBurnInProtection;
        var aod = _asleep && burnIn;
        var clock = System.getClockTime();

        // Activity history only changes between activities; once a minute is plenty.
        if (clock.min != _weekLoadedMinute) {
            _week.load();
            _weekLoadedMinute = clock.min;
        }

        _cx = w / 2;
        _cy = h / 2;
        // No always-on drift: the stripes alternate every minute, so no pixel stays lit longer than that,
        // and the time stays in exactly the same spot when the watch wakes.

        dc.setColor(COLOR_BG, COLOR_BG);
        dc.clear();
        if (dc has :setAntiAlias) {
            dc.setAntiAlias(true);
        }

        var conditions = (Toybox has :Weather) ? Weather.getCurrentConditions() : null;
        drawPanel(dc, clock, settings.is24Hour, aod);
        if (aod) {
            drawStripes(dc, clock);
            return;
        }

        drawSportRings(dc);
        drawStatus(dc, settings);
        drawWeather(dc, conditions, settings);
        drawReadouts(dc);
        drawCountdown(dc);
    }

    // ---- Sections ----

    // The bordered LCD panel: day and date on top, then the time with AM/PM and seconds.
    private function drawPanel(dc as Graphics.Dc, clock as System.ClockTime, is24Hour as Boolean, aod as Boolean) as Void {
        var today = Gregorian.info(Time.now(), Time.FORMAT_SHORT);
        var ink = aod ? COLOR_MUTED : COLOR_INK;
        var dim = aod ? COLOR_FAINT : COLOR_INK;
        var line = aod ? COLOR_OFF : COLOR_PANEL_LINE;

        if (!aod) {
            dc.setColor(COLOR_PANEL, COLOR_PANEL);
            dc.fillRoundedRectangle(x(74), y(162), sz(296), sz(150), sz(12));
        }
        dc.setColor(line, Graphics.COLOR_TRANSPARENT);
        dc.setPenWidth(sz(2));
        dc.drawRoundedRectangle(x(74), y(162), sz(296), sz(150), sz(12));
        dc.setPenWidth(1);
        dc.drawRoundedRectangle(x(230), y(167), sz(128), sz(46), sz(6));

        // Day of the week, then month-day in its inset box.
        drawSeg(dc, 90, 172, _segDay, 4.5, DAY_NAMES[(today.day_of_week as Number) - 1], dim);
        var dateStr = (today.month as Number).format("%02d") + "-" + (today.day as Number).format("%02d");
        if (!aod) {
            drawSeg(dc, 240, 173, _segDate, 5, "88-88", COLOR_GHOST);
        }
        drawSeg(dc, 240, 173, _segDate, 5, dateStr, dim);

        // Time. In 12-hour mode a leading zero goes dark instead, like an LCD.
        var hour = clock.hour;
        var hourStr;
        if (is24Hour) {
            hourStr = hour.format("%02d");
        } else {
            hour = hour % 12 == 0 ? 12 : hour % 12;
            hourStr = hour < 10 ? " " + hour.toString() : hour.toString();
        }
        if (!aod) {
            drawSeg(dc, 90, 224, _segTime, 10, "88:88", COLOR_GHOST);
        }
        drawSeg(dc, 90, 224, _segTime, 10, hourStr + ":" + clock.min.format("%02d"), ink);
        if (aod) {
            return;
        }
        if (!is24Hour) {
            drawSeg(dc, 316, 226, _segAmPm, 3, clock.hour < 12 ? "AM" : "PM", COLOR_MUTED);
        }
        drawSeg(dc, 316, 266, _segSecs, 4, "88", COLOR_GHOST);
        drawSeg(dc, 316, 266, _segSecs, 4, clock.sec.format("%02d"), COLOR_ACCENT);
    }

    // Swim, bike and run rings over the panel. Each fills from 12 o'clock toward that sport's
    // weekly time target; inside are the icon, the week's distance and the week's time.
    private function drawSportRings(dc as Graphics.Dc) as Void {
        var statute = System.getDeviceSettings().distanceUnits == System.UNIT_STATUTE;
        for (var i = 0; i < 3; i++) {
            var rx = x(117 + i * 110);
            var ry = y(100);
            dc.setColor(COLOR_TRACK, Graphics.COLOR_TRANSPARENT);
            dc.setPenWidth(sz(7));
            dc.drawCircle(rx, ry, sz(RING_R));
            var minutes = _week.seconds[i] / 60;
            var target = targetMinutes(i);
            if (minutes >= target) {
                dc.setColor(SPORT_COLORS[i], Graphics.COLOR_TRANSPARENT);
                dc.drawCircle(rx, ry, sz(RING_R));
            } else if (minutes > 0) {
                drawArcAt(dc, rx, ry, sz(RING_R), 0.0, 360.0 * minutes / target, SPORT_COLORS[i], 7);
            }

            dc.drawBitmap(rx - sz(12), y(60), _sportIcons[i]);
            var value = distanceValue(i, statute);
            var unit = distanceUnit(i, statute);
            var vw = dc.getTextWidthInPixels(value, _val);
            var uw = dc.getTextWidthInPixels(unit, _small);
            var x0 = rx - (vw + 2 + uw) / 2;
            drawBaseline(dc, x0, y(112), _val, value, COLOR_INK, Graphics.TEXT_JUSTIFY_LEFT);
            drawBaseline(dc, x0 + vw + 2, y(112), _small, unit, COLOR_MUTED, Graphics.TEXT_JUSTIFY_LEFT);
            drawBaseline(dc, rx, y(136), _bold, formatMinutes(minutes), COLOR_MUTED, Graphics.TEXT_JUSTIFY_CENTER);
        }
    }

    // Phone connected, do not disturb, alarm set, down the left. Lit when on, faint when off.
    private function drawStatus(dc as Graphics.Dc, settings as System.DeviceSettings) as Void {
        var dnd = (settings has :doNotDisturb) && settings.doNotDisturb;
        var on = [settings.phoneConnected, dnd, settings.alarmCount > 0];
        for (var i = 0; i < 3; i++) {
            dc.drawBitmap(x(28), y(176 + i * 44), on[i] ? _statusOn[i] : _statusOff[i]);
        }
    }

    // Wind dial (the arrow points where the wind is blowing) with its speed, then the current
    // conditions over the temperature.
    private function drawWeather(dc as Graphics.Dc, conditions as Weather.CurrentConditions?, settings as System.DeviceSettings) as Void {
        var wx = x(410);
        var wy = y(184);
        var wr = sz(21);
        dc.setColor(COLOR_MUTED, Graphics.COLOR_TRANSPARENT);
        dc.setPenWidth(sz(2));
        dc.drawCircle(wx, wy, wr);
        dc.fillRectangle(wx - 1, wy - wr - sz(4), 2, sz(5));

        var statute = settings.distanceUnits == System.UNIT_STATUTE;
        var windText = "--";
        if (conditions != null && conditions.windBearing != null) {
            // Weather reports where the wind comes from; the arrow shows where it's going.
            var a = Math.toRadians(((conditions.windBearing as Number) + 180) % 360);
            var px = [0, 9, 0, -9] as Array<Number>;
            var py = [-18, 10, 6, 10] as Array<Number>;
            var poly = [];
            for (var i = 0; i < 4; i++) {
                var ax = px[i] * _s;
                var ay = py[i] * _s;
                poly.add([wx + ax * Math.cos(a) - ay * Math.sin(a), wy + ax * Math.sin(a) + ay * Math.cos(a)]);
            }
            dc.setColor(COLOR_INK, Graphics.COLOR_TRANSPARENT);
            dc.fillPolygon(poly);
        }
        if (conditions != null && conditions.windSpeed != null) {
            var ms = (conditions.windSpeed as Float).toFloat();
            windText = Math.round(statute ? ms * 2.23694 : ms * 3.6).toNumber().toString() + (statute ? " MPH" : " KMH");
        }
        drawBaseline(dc, wx, y(230), _bold, windText, COLOR_INK, Graphics.TEXT_JUSTIFY_CENTER);

        var temp = temperature(conditions, settings);
        if (conditions != null && conditions.condition != null) {
            var condition = conditions.condition as Number;
            if (condition != _wxCondition || _wxIcon == null) {
                _wxIcon = WatchUi.loadResource(conditionIcon(condition)) as WatchUi.BitmapResource;
                _wxCondition = condition;
            }
            dc.drawBitmap(wx - sz(14), y(242), _wxIcon as WatchUi.BitmapResource);
        }
        // Center the digits on the column, letting the degree sign hang off to the right.
        var degree = temp.find("°") != null ? dc.getTextWidthInPixels("°", _temp) : 0;
        drawBaseline(dc, wx + degree / 2, y(300), _temp, temp, COLOR_INK, Graphics.TEXT_JUSTIFY_CENTER);
    }

    // Garmin's 50-odd weather conditions, folded into seven icons.
    private function conditionIcon(c as Number) as ResourceId {
        switch (c) {
            case Weather.CONDITION_CLEAR:
            case Weather.CONDITION_FAIR:
            case Weather.CONDITION_MOSTLY_CLEAR:
                return Rez.Drawables.IconWxClear;
            case Weather.CONDITION_PARTLY_CLOUDY:
            case Weather.CONDITION_PARTLY_CLEAR:
            case Weather.CONDITION_THIN_CLOUDS:
                return Rez.Drawables.IconWxPartly;
            case Weather.CONDITION_RAIN:
            case Weather.CONDITION_SCATTERED_SHOWERS:
            case Weather.CONDITION_UNKNOWN_PRECIPITATION:
            case Weather.CONDITION_LIGHT_RAIN:
            case Weather.CONDITION_HEAVY_RAIN:
            case Weather.CONDITION_LIGHT_SHOWERS:
            case Weather.CONDITION_SHOWERS:
            case Weather.CONDITION_HEAVY_SHOWERS:
            case Weather.CONDITION_CHANCE_OF_SHOWERS:
            case Weather.CONDITION_DRIZZLE:
            case Weather.CONDITION_CLOUDY_CHANCE_OF_RAIN:
            case Weather.CONDITION_FREEZING_RAIN:
                return Rez.Drawables.IconWxRain;
            case Weather.CONDITION_SNOW:
            case Weather.CONDITION_WINTRY_MIX:
            case Weather.CONDITION_HAIL:
            case Weather.CONDITION_LIGHT_SNOW:
            case Weather.CONDITION_HEAVY_SNOW:
            case Weather.CONDITION_LIGHT_RAIN_SNOW:
            case Weather.CONDITION_HEAVY_RAIN_SNOW:
            case Weather.CONDITION_RAIN_SNOW:
            case Weather.CONDITION_ICE:
            case Weather.CONDITION_CHANCE_OF_SNOW:
            case Weather.CONDITION_CHANCE_OF_RAIN_SNOW:
            case Weather.CONDITION_CLOUDY_CHANCE_OF_SNOW:
            case Weather.CONDITION_CLOUDY_CHANCE_OF_RAIN_SNOW:
            case Weather.CONDITION_FLURRIES:
            case Weather.CONDITION_SLEET:
            case Weather.CONDITION_ICE_SNOW:
                return Rez.Drawables.IconWxSnow;
            case Weather.CONDITION_THUNDERSTORMS:
            case Weather.CONDITION_SCATTERED_THUNDERSTORMS:
            case Weather.CONDITION_CHANCE_OF_THUNDERSTORMS:
            case Weather.CONDITION_TORNADO:
            case Weather.CONDITION_SQUALL:
            case Weather.CONDITION_HURRICANE:
            case Weather.CONDITION_TROPICAL_STORM:
                return Rez.Drawables.IconWxThunder;
            case Weather.CONDITION_FOG:
            case Weather.CONDITION_HAZY:
            case Weather.CONDITION_MIST:
            case Weather.CONDITION_DUST:
            case Weather.CONDITION_SMOKE:
            case Weather.CONDITION_SAND:
            case Weather.CONDITION_SANDSTORM:
            case Weather.CONDITION_VOLCANIC_ASH:
            case Weather.CONDITION_HAZE:
                return Rez.Drawables.IconWxFog;
        }
        // Cloudy, windy and anything unknown.
        return Rez.Drawables.IconWxCloudy;
    }

    // Under the panel, an icon beside each number: steps from the panel's left edge across its left half,
    // battery from the middle, heart rate ending at the panel's right edge.
    private function drawReadouts(dc as Graphics.Dc) as Void {
        var steps = ActivityMonitor.getInfo().steps;
        var hr = heartRate();
        var values = [
            steps == null ? "--" : thousands(steps),
            Math.round(System.getSystemStats().battery).toNumber().toString() + "%",
            hr == null ? "--" : hr.toString()
        ];
        for (var i = 0; i < 3; i++) {
            var vw = dc.getTextWidthInPixels(values[i], _row);
            var x0 = i == 0 ? x(74) : (i == 1 ? x(227) : x(370) - sz(28) - vw);
            // Icon and number share one center line. VCENTER centers the font's box, which for
            // Roboto lands within a pixel of the digits' middle, whatever ascent the font reports.
            dc.drawBitmap(x0, y(342) - sz(12), _icons[i]);
            dc.setColor(COLOR_INK, Graphics.COLOR_TRANSPARENT);
            dc.drawText(x0 + sz(28), y(342), _row, values[i], Graphics.TEXT_JUSTIFY_LEFT | Graphics.TEXT_JUSTIFY_VCENTER);
        }
    }

    // Days to race day, with "DAYS UNTIL <label>" curved along the bottom bezel.
    private function drawCountdown(dc as Graphics.Dc) as Void {
        var daysLeft = daysUntil(Application.Properties.getValue("RaceDate"), Gregorian.info(Time.now(), Time.FORMAT_SHORT));
        if (daysLeft == null || daysLeft < 0) {
            return;
        }
        var labelSetting = Application.Properties.getValue("RaceLabel");
        var label = (labelSetting instanceof String && labelSetting.length() > 0) ? labelSetting.toUpper() : "RACE";
        var text = daysLeft == 0 ? "IT'S RACE DAY" : (daysLeft == 1 ? "DAY" : "DAYS") + " UNTIL " + label;
        drawBaseline(dc, _cx, y(403), _big, daysLeft.toString(), COLOR_INK, Graphics.TEXT_JUSTIFY_CENTER);
        if ((dc has :drawRadialText) && _vector) {
            dc.setColor(COLOR_MUTED, Graphics.COLOR_TRANSPARENT);
            dc.drawRadialText(_cx, _cy, _bold, text, Graphics.TEXT_JUSTIFY_CENTER, 270, sz(210),
                Graphics.RADIAL_TEXT_DIRECTION_COUNTER_CLOCKWISE);
        } else {
            drawBaseline(dc, _cx, y(424), _bold, text, COLOR_MUTED, Graphics.TEXT_JUSTIFY_CENTER);
        }
    }

    // Every other pixel row blacked out, alternating each minute, for AMOLED burn-in protection.
    private function drawStripes(dc as Graphics.Dc, clock as System.ClockTime) as Void {
        if (dc has :setAntiAlias) {
            dc.setAntiAlias(false);
        }
        dc.setColor(COLOR_BG, COLOR_BG);
        dc.setPenWidth(1);
        for (var row = clock.min % 2; row < dc.getHeight(); row += 2) {
            dc.drawLine(0, row, dc.getWidth(), row);
        }
    }

    // ---- Data ----

    private function heartRate() as Number? {
        var info = Activity.getActivityInfo();
        if (info != null && info.currentHeartRate != null) {
            return info.currentHeartRate;
        }
        if (ActivityMonitor has :getHeartRateHistory) {
            var sample = ActivityMonitor.getHeartRateHistory(1, true).next();
            if (sample != null && sample.heartRate != ActivityMonitor.INVALID_HR_SAMPLE) {
                return sample.heartRate;
            }
        }
        return null;
    }

    private function temperature(conditions as Weather.CurrentConditions?, settings as System.DeviceSettings) as String {
        if (conditions != null && conditions.temperature != null) {
            var t = (conditions.temperature as Numeric).toFloat();
            if (settings.temperatureUnits == System.UNIT_STATUTE) {
                t = t * 9 / 5 + 32;
            }
            return Math.round(t).toNumber().toString() + "°";
        }
        return "--";
    }

    private function targetMinutes(sport as Number) as Number {
        var value = Application.Properties.getValue(TARGET_KEYS[sport]);
        return (value instanceof Number && value > 0) ? value : DEFAULT_TARGETS[sport];
    }

    // Days from today to a "YYYY-MM-DD" setting, or null if it doesn't parse.
    private function daysUntil(value as Application.PropertyValueType, today as Gregorian.Info) as Number? {
        if (!(value instanceof String) || value.length() != 10) {
            return null;
        }
        var yr = value.substring(0, 4).toNumber();
        var mo = value.substring(5, 7).toNumber();
        var dy = value.substring(8, 10).toNumber();
        if (yr == null || mo == null || dy == null) {
            return null;
        }
        return civilDays(yr, mo, dy) - civilDays(today.year as Number, today.month as Number, today.day as Number);
    }

    // Days since 1970-01-01 for a calendar date (Howard Hinnant's algorithm), so date math ignores time zones.
    private function civilDays(yr as Number, mo as Number, dy as Number) as Number {
        if (mo <= 2) {
            yr -= 1;
        }
        var era = (yr >= 0 ? yr : yr - 399) / 400;
        var yoe = yr - era * 400;
        var doy = (153 * (mo + (mo > 2 ? -3 : 9)) + 2) / 5 + dy - 1;
        var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
        return era * 146097 + doe - 719468;
    }

    // ---- Formatting ----

    private function distanceValue(sport as Number, statute as Boolean) as String {
        var m = _week.meters[sport];
        if (sport == SPORT_SWIM) {
            return thousands((statute ? m * 1.09361 : m).toNumber());
        }
        return (statute ? m / 1609.344 : m / 1000).format("%.1f");
    }

    private function distanceUnit(sport as Number, statute as Boolean) as String {
        if (sport == SPORT_SWIM) {
            return statute ? "YD" : "M";
        }
        return statute ? "MI" : "KM";
    }

    private function formatMinutes(m as Number) as String {
        return (m / 60).format("%d") + ":" + (m % 60).format("%02d");
    }

    private function thousands(n as Number) as String {
        if (n < 1000) {
            return n.toString();
        }
        return thousands(n / 1000) + "," + (n % 1000).format("%03d");
    }

    // ---- Drawing helpers ----

    // An arc around any center, between two angles in degrees clockwise from 12 o'clock, in either direction.
    private function drawArcAt(dc as Graphics.Dc, cx as Number, cy as Number, r as Number, from as Float, to as Float,
            color as Number, width as Number) as Void {
        var span = to - from;
        if (span < 0.5 && span > -0.5) {
            return;
        }
        dc.setColor(color, Graphics.COLOR_TRANSPARENT);
        dc.setPenWidth(sz(width));
        var dir = span > 0 ? Graphics.ARC_CLOCKWISE : Graphics.ARC_COUNTER_CLOCKWISE;
        dc.drawArc(cx, cy, r, dir, toArcDegrees(from), toArcDegrees(to));
    }

    // Garmin arcs count counter-clockwise from 3 o'clock.
    private function toArcDegrees(clockDeg as Float) as Float {
        var d = 90.0 - clockDeg;
        while (d < 0) {
            d += 360.0;
        }
        while (d >= 360) {
            d -= 360.0;
        }
        return d;
    }

    // Segment text with its first glyph's ink at design point (px, top). The generated glyphs carry
    // half the segment spacing as a left offset, so pull back by that much.
    private function drawSeg(dc as Graphics.Dc, px as Number, top as Number, font as WatchUi.FontResource,
            thickness as Float or Number, text as String, color as Number) as Void {
        dc.setColor(color, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x(px) - Math.round(thickness * 0.45).toNumber(), y(top), font, text, Graphics.TEXT_JUSTIFY_LEFT);
    }

    // A built-in scalable font at a pixel size, or the bundled bitmap font if this watch has none.
    private function textFont(faces as Array<String>, size as Number, fallback as ResourceId) as Graphics.FontType {
        if (Graphics has :getVectorFont) {
            var font = Graphics.getVectorFont({:face => faces, :size => size});
            if (font != null) {
                _vector = true;
                return font;
            }
        }
        return WatchUi.loadResource(fallback) as WatchUi.FontResource;
    }

    // Text placed by its baseline, the way the mockup lays it out.
    private function drawBaseline(dc as Graphics.Dc, px as Numeric, baseline as Numeric, font as Graphics.FontType,
            text as String, color as Number, justify as Number) as Void {
        dc.setColor(color, Graphics.COLOR_TRANSPARENT);
        dc.drawText(px, baseline - Graphics.getFontAscent(font), font, text, justify);
    }

    private function x(v as Numeric) as Number {
        return _cx + ((v - 227) * _s).toNumber();
    }

    private function y(v as Numeric) as Number {
        return _cy + ((v - 227) * _s).toNumber();
    }

    // A design-size length, scaled.
    private function sz(v as Numeric) as Number {
        return (v * _s).toNumber();
    }

    function onExitSleep() as Void {
        _asleep = false;
        WatchUi.requestUpdate();
    }

    function onEnterSleep() as Void {
        _asleep = true;
        WatchUi.requestUpdate();
    }
}
