// Cloudflare Workers config: serves the static build in dist/, plus a small Worker (worker/index.js)
// for the newsletter signup at /api/*. Everything else goes straight to the static files.
// The name must match the Worker in the Cloudflare dashboard (ai-tri-coach), or Workers Builds fails.
{
  "name": "ai-tri-coach",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* runs the Worker; pages and files are served without it.
    "run_worker_first": ["/api/*"]
  },
  // Non-secret settings. RESEND_API_KEY, SIGNUP_SECRET and RESEND_SEGMENT_ID are set as secrets in the
  // Cloudflare dashboard (Worker > Settings > Variables and secrets), never here. Secrets survive deploys.
  "vars": {
    "NEWSLETTER_FROM": "James at Split Decisions <newsletter@splitdecisionscoach.com>"
  },
  // Lets Workers Builds run `wrangler preview` for pull requests. Empty is fine: assets and
  // compatibility settings stay at the top level.
  "previews": {}
}
