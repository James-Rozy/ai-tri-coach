// Cloudflare Workers config: serves the static build in dist/, no server code.
// The name must match the Worker in the Cloudflare dashboard (ai-tri-coach), or Workers Builds fails.
{
  "name": "ai-tri-coach",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Lets Workers Builds run `wrangler preview` for pull requests. Empty is fine: assets and
  // compatibility settings stay at the top level.
  "previews": {}
}
