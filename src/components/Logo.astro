---
// Split Decisions logo, "the fork": the course line draws the S, and at the decision point (the ring)
// the amber D splits off. Inline SVG so its colors follow the CSS tokens.
interface Props {
  /** Show the "Split Decisions" wordmark next to the mark. */
  wordmark?: boolean;
}
const { wordmark = true } = Astro.props;
---
<span class="logo">
  <svg class="mark" viewBox="0 0 64 64" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="6" aria-hidden="true">
    <path class="s" pathLength="1" d="M5 57 C14 60 29 59 29 47 C29 34 7 37 7 22 C7 11 17 6 28 9" />
    <path class="d" pathLength="1" d="M29 47 C29 51 33 52 37 52 H40 C52 52 59 43 59 30 C59 17 52 8 40 8 H37 V52" />
    <circle class="node" cx="29" cy="47" r="5" stroke-width="3.5" />
  </svg>
  {wordmark && <span class="word"><span class="split">Split</span> Decisions</span>}
</span>

<style>
  @layer components {
    .logo { display: inline-flex; align-items: center; gap: 0.5em; }
    .mark { block-size: 1.9em; inline-size: 1.9em; flex: none; }
    .s { stroke: var(--ink); }
    .d { stroke: var(--accent); }
    .node { stroke: var(--accent); fill: var(--bg); }
    .word {
      font-family: var(--font-display);
      font-weight: 900;
      font-stretch: 75%;
      font-size: 1.35em;
      line-height: 1;
      letter-spacing: 0.01em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .split { color: var(--accent); }

    /* On first load the S draws in, then the D splits off it. Hovering the logo replays the D. */
    @media (prefers-reduced-motion: no-preference) {
      .s, .d { stroke-dasharray: 1; }
      .s { animation: draw 0.6s ease-out both; }
      .d { animation: draw 0.55s 0.45s ease-out both; }
      .node { animation: pop 0.3s 0.4s ease-out both; transform-origin: 29px 47px; }
      :global(a:hover) > .logo .d { animation: redraw 0.55s ease-out; }
    }
    @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
    @keyframes redraw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
    @keyframes pop { from { scale: 0; } 70% { scale: 1.3; } to { scale: 1; } }
  }
</style>
