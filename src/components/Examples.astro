---
interface Props {
  examples: string[];
}
const { examples } = Astro.props;
---
{examples.length > 0 && (
  <details class="examples">
    <summary>How it fills in for different sports</summary>
    <ul>
      {examples.map((example) => <li>{example}</li>)}
    </ul>
  </details>
)}

<style>
  @layer components {
    .examples { font-size: var(--step--1); color: var(--ink-muted); }
    summary { cursor: pointer; color: var(--ink); }
    ul { margin-block-start: 0.5em; padding-inline-start: 1.25em; display: grid; gap: 0.25em; }
  }
</style>
