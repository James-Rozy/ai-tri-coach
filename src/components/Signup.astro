---
interface Props {
  /** "card" for the box at the bottom of pages, "bare" for just the form (the newsletter page). */
  variant?: 'card' | 'bare';
}
const { variant = 'card' } = Astro.props;
const id = `email-${Math.random().toString(36).slice(2, 8)}`;
---
<section class:list={['signup', variant]} aria-labelledby={variant === 'card' ? `${id}-h` : undefined}>
  {variant === 'card' && (
    <div class="stack">
      <h2 id={`${id}-h`}>Follow the build</h2>
      <p class="muted">
        Every other Sunday: the new episode, one prompt from that week of training, and the numbers. Including the weeks
        that go badly.
      </p>
    </div>
  )}
  <!-- TODO: point this at the email provider once it's picked. Disabled until then. -->
  <form class="form" action="#" method="post" aria-describedby={`${id}-note`}>
    <label class="visually-hidden" for={id}>Email</label>
    <input id={id} name="email" type="email" placeholder="you@example.com" autocomplete="email" required disabled />
    <button type="submit" disabled>Sign me up</button>
  </form>
  <p id={`${id}-note`} class="note mono">Signup opens soon. In the meantime, follow <a href="https://www.youtube.com/@splitdecisionscoach">@splitdecisionscoach on YouTube</a>.</p>
</section>

<style>
  @layer components {
    .signup { display: grid; gap: var(--space-s); }
    .card {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
      align-items: end;
      gap: var(--space-m);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: var(--space-l) var(--space-m);
      position: relative;
      overflow: hidden;
    }
    /* A finish-line checker strip along the top of the card. */
    .card::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      block-size: 6px;
      background: repeating-conic-gradient(var(--ink) 0 25%, var(--bg) 0 50%) 0 0 / 6px 6px;
      opacity: 0.5;
    }
    .card .note { grid-column: 1 / -1; }
    .form { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    input {
      flex: 1 1 14rem;
      padding: 0.8em 1em;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--bg);
      color: var(--ink);
    }
    button {
      padding: 0.8em 1.4em;
      border: 0;
      border-radius: 6px;
      background: var(--accent);
      color: var(--on-accent);
      font-weight: 700;
    }
    :disabled { opacity: 0.6; cursor: not-allowed; }
    .note { font-size: 0.8rem; color: var(--ink-faint); }
    .note a { color: var(--ink-muted); }
  }
</style>
