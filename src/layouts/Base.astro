---
import '../styles/global.css';
import Disclaimer from '../components/Disclaimer.astro';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Set up an AI coach that plans from your own data and tells you when you are off track. A free guide for any sport, tested in public on my build to a first Ironman.',
} = Astro.props;

const nav = [
  { href: '/guide/', label: 'Guide' },
  { href: '/setup/', label: 'Setup' },
  { href: '/progress/', label: 'My progress' },
  { href: '/watch-faces/', label: 'Watch faces' },
  { href: '/about/', label: 'About' },
];
const socials = [
  { name: 'YouTube', href: 'https://www.youtube.com/@splitdecisionscoach' },
  { name: 'Instagram', href: 'https://www.instagram.com/splitdecisionscoach/' },
  { name: 'TikTok', href: 'https://www.tiktok.com/@splitdecisionscoach' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
const fullTitle = title === 'Home' ? 'Split Decisions · Build your own AI coach' : `${title} · Split Decisions`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <slot name="head" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label="Split Decisions, home"><Logo /></a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
          <a class="cta" href="/newsletter/" aria-current={isCurrent('/newsletter/') ? 'page' : undefined}>Newsletter</a>
        </nav>
        <!-- Phones: one slim row with a Menu button that opens the course map as a popover (no JS). -->
        <button class="menu-btn mono" type="button" popovertarget="menu" aria-label="Open menu">
          Menu <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
        <div id="menu" class="menu" popover>
          <div class="menu-head mono">
            <span>Course map</span>
            <button type="button" popovertarget="menu" popovertargetaction="hide" aria-label="Close menu">Close ✕</button>
          </div>
          <nav aria-label="Main, mobile">
            <ol>
              {[...nav, { href: '/newsletter/', label: 'Newsletter' }].map((item, i) => (
                <li style={`--i: ${i}`}>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    <span class="mono split">{i < nav.length ? String(i + 1).padStart(2, '0') : 'Fin'}</span>
                    <span class="item">{item.label}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div class="stack">
          <a href="/" class="brand" aria-label="Split Decisions, home"><Logo /></a>
          <p class="muted">Build an AI coach that works from your data. Tested in public on an Ironman.</p>
        </div>
        <nav aria-label="Footer">
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            <li><a href="/newsletter/">Newsletter</a></li>
          </ul>
        </nav>
        <nav class="socials" aria-label="Split Decisions elsewhere">
          <span class="handle mono">@splitdecisionscoach</span>
          <ul>
            {socials.map((s) => <li><a href={s.href} rel="me">{s.name}</a></li>)}
          </ul>
        </nav>
      </div>
      <div class="wrap fine stack">
        <Disclaimer />
        <p class="muted">&copy; {new Date().getFullYear()} James Rozy</p>
      </div>
    </footer>
  </body>
</html>

<style>
  @layer components {
    .skip {
      position: absolute;
      inset-block-start: -10rem;
      inset-inline-start: var(--gutter);
      padding: 0.5em 1em;
      background: var(--accent);
      color: var(--on-accent);
      z-index: 10;
    }
    .skip:focus { inset-block-start: 0.5rem; }

    .site-header {
      position: sticky;
      inset-block-start: 0;
      z-index: 5;
      background: rgb(14 17 22 / 0.82);
      backdrop-filter: blur(10px);
      border-block-end: 1px solid var(--line);
    }
    .bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem var(--space-m);
      padding-block: 0.8rem;
    }
    .brand { display: inline-flex; min-block-size: 44px; align-items: center; text-decoration: none; font-size: 1.05rem; view-transition-name: brand; }
    nav ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.25rem var(--space-m); }
    nav a { text-decoration: none; }
    .bar nav { display: flex; align-items: center; gap: var(--space-m); font-size: var(--step--1); }
    .bar nav ul a {
      position: relative;
      color: var(--ink-muted);
      padding-block: 0.35rem;
      white-space: nowrap;
    }
    /* The current page gets a timing-mat strip under it; hover previews it. */
    .bar nav ul a::after {
      content: "";
      position: absolute;
      inset-inline: 0;
      inset-block-end: -2px;
      block-size: 2px;
      background: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 9px);
      scale: 0 1;
      transform-origin: left;
      transition: scale 0.25s ease-out;
    }
    .bar nav ul a:hover, .bar nav ul a[aria-current] { color: var(--ink); }
    .bar nav ul a:hover::after, .bar nav ul a[aria-current]::after { scale: 1 1; }
    .cta {
      padding: 0.45em 1em;
      border-radius: 999px;
      box-shadow: inset 0 0 0 1px var(--accent);
      color: var(--accent);
      font-weight: 600;
      white-space: nowrap;
    }
    .cta:hover, .cta[aria-current] { background: var(--accent); color: var(--on-accent); }

    .menu-btn, .menu { display: none; }

    /* Phones: the inline links give way to a Menu button and a full-width popover. */
    @media (width < 52rem) {
      .bar { padding-block: 0.5rem; }
      .bar > nav { display: none; }
      .menu-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        min-block-size: 44px;
        padding-inline: 0.9rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--surface);
        color: var(--ink);
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
      }
      .bars { display: grid; gap: 3px; }
      .bars i { display: block; inline-size: 16px; block-size: 2px; background: var(--accent); }
      .bars i:nth-child(2) { inline-size: 11px; }
      .bars i:nth-child(3) { inline-size: 6px; }

      .menu:popover-open {
        display: grid;
        gap: var(--space-s);
        position: fixed;
        inset: 0 0 auto;
        margin: 0;
        inline-size: 100%;
        max-inline-size: none;
        padding: 0.75rem var(--gutter) var(--space-m);
        border: 0;
        border-block-end: 1px solid var(--line);
        background: var(--bg);
        color: var(--ink);
        box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.6);
        transition: translate 0.25s ease-out, opacity 0.25s, display 0.25s allow-discrete, overlay 0.25s allow-discrete;
      }
      @starting-style { .menu:popover-open { translate: 0 -1rem; opacity: 0; } }
      .menu::backdrop { background: rgb(0 0 0 / 0.5); }
      .menu-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--ink-faint);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .menu-head button {
        min-block-size: 44px;
        padding-inline: 0.9rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: transparent;
        color: var(--ink);
        font: inherit;
        cursor: pointer;
      }
      .menu nav { display: block; }
      .menu ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; }
      .menu li a {
        display: grid;
        grid-template-columns: 2.75rem 1fr auto;
        align-items: center;
        min-block-size: 56px;
        padding-inline: 0.8rem;
        border-radius: 6px;
        border-inline-start: 3px solid var(--line);
        background: var(--surface);
        text-decoration: none;
      }
      .menu li:last-child a { border-inline-start-color: var(--accent); }
      .menu li:last-child .item { color: var(--accent); }
      .menu li a[aria-current] { border-inline-start-color: var(--accent); background: var(--surface-2); }
      .menu .split { color: var(--ink-faint); font-size: 0.8rem; text-transform: uppercase; }
      .menu .item {
        font-family: var(--font-display);
        font-weight: 900;
        font-stretch: 75%;
        font-size: var(--step-1);
        text-transform: uppercase;
      }
      @media (prefers-reduced-motion: no-preference) {
        .menu:popover-open li { animation: menu-in 0.3s calc(var(--i) * 0.04s) ease-out both; }
      }
      @keyframes menu-in { from { opacity: 0; translate: -0.5rem 0; } }
    }

    .site-footer {
      border-block-start: 1px solid var(--line);
      padding-block: var(--space-l);
      font-size: var(--step--1);
      display: grid;
      gap: var(--space-l);
    }
    .foot {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
      gap: var(--space-m);
      align-items: start;
    }
    .foot nav ul { flex-direction: column; gap: 0; }
    /* Comfortable tap targets for stacked footer links. */
    .foot nav ul a { display: inline-block; padding-block: 0.6rem; }
    .foot a:hover { color: var(--accent); }
    .socials { display: grid; gap: 0.4rem; }
    .socials ul { gap: 0; }
    .handle { color: var(--accent); }
    .fine { border-block-start: 1px solid var(--line); padding-block-start: var(--space-m); }
  }
</style>
