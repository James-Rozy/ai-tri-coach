---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CopyButton from '../../components/CopyButton.astro';

export async function getStaticPaths() {
  // Only free prompts get public pages; paid ones will live behind the membership.
  const prompts = await getCollection('prompts', ({ data }) => data.tier === 'free');
  return prompts.map((prompt) => ({ params: { id: prompt.id }, props: { prompt } }));
}

interface Props {
  prompt: CollectionEntry<'prompts'>;
}
const { prompt } = Astro.props;
const { Content } = await render(prompt);
const textId = `text-${prompt.id}`;
---
<Base title={prompt.data.title} description={prompt.data.summary}>
  <article class="wrap section stack page" style={`view-transition-name: prompt-${prompt.id}`}>
    <p class="num">Prompt {prompt.data.order}</p>
    <h1>{prompt.data.title}</h1>
    <p class="muted">{prompt.data.summary}</p>
    <p><strong>Use it:</strong> {prompt.data.useWhen}</p>
    <div class="prompt-text" id={textId}><Content /></div>
    <CopyButton target={textId} />
    <p><a href="/kit/">See the full starter kit</a></p>
  </article>
</Base>

<style>
  @layer components {
    .page { --stack-gap: var(--space-m); max-inline-size: 48rem; }
    .num { font-family: var(--font-mono); font-size: var(--step--1); color: var(--accent); }
    .prompt-text {
      background: var(--surface);
      border: 1px solid var(--line);
      border-inline-start: 4px solid var(--accent);
      border-radius: var(--radius);
      padding: var(--space-m);
      font-family: var(--font-mono);
      font-size: var(--step--1);
    }
    .prompt-text :global(ul) { padding-inline-start: 1.25em; }
    .prompt-text :global(* + *) { margin-block-start: 0.6em; }
  }
</style>
