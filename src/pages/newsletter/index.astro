---
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';

const inside = [
  { label: 'The plan', body: 'Every session for the week ahead, straight from my training calendar.' },
  { label: 'The why', body: 'The reasoning behind the week in plain language, the way my coach explained it to me.' },
  { label: 'The numbers', body: 'Last week’s hours and sessions, planned vs done.' },
  { label: 'The miss', body: 'Whatever went wrong, and what changes because of it. Plus the new episode when there is one.' },
];

// Errors come back from the signup Worker as ?error=... (see worker/index.js).
const errors: Record<string, string> = {
  email: 'That email address doesn’t look right. Try again?',
  link: 'That confirm link is invalid or more than 7 days old. Sign up again and I’ll send a fresh one.',
  send: 'Something went wrong on my end. Try again in a minute.',
  closed: 'Signup isn’t open yet. Check back soon.',
};
---
<Base title="Newsletter" description="Every Monday: my training plan for the week, the reasoning behind it, and how last week actually went. Free.">
  <section class="wrap section hero">
    <div class="stack copy">
      <p class="label">Newsletter · every Monday</p>
      <h1>My training week, in one email.</h1>
      <p class="lede muted">
        Short, honest and useful even if you never watch the videos. Free, and one click to leave.
      </p>
      <p class="error mono" role="alert" hidden data-errors={JSON.stringify(errors)}></p>
      <Signup variant="bare" />
      <p class="muted small">Want to see one first? <a href="/training/">Here’s this week’s plan.</a></p>
    </div>

    <div class="issue mono" aria-label="What’s in each issue">
      <div class="issue-head"><span>Issue format</span><span>Every Monday</span></div>
      <ol>
        {inside.map((x, i) => (
          <li>
            <span class="lap">Lap {i + 1}</span>
            <strong>{x.label}</strong>
            <span class="body">{x.body}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<script>
  // Static page, so read the error code in the browser. Unknown codes are ignored.
  const el = document.querySelector<HTMLElement>('.error');
  const code = new URLSearchParams(location.search).get('error');
  const msg = el && code ? JSON.parse(el.dataset.errors ?? '{}')[code] : undefined;
  if (el && msg) { el.textContent = msg; el.hidden = false; }
</script>

<style>
  @layer components {
    .hero {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
      gap: var(--space-l);
      align-items: center;
      min-block-size: 70vh;
    }
    .copy { --stack-gap: var(--space-m); }
    .lede { font-size: var(--step-1); line-height: 1.5; }
    .error { color: var(--accent); border: 1px solid var(--accent); border-radius: 6px; padding: 0.6em 0.9em; font-size: var(--step--1); }
    .small { font-size: var(--step--1); }
    .issue {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: var(--space-m);
      font-size: var(--step--1);
      rotate: 1.5deg;
      box-shadow: 0 2rem 4rem rgb(0 0 0 / 0.35);
      transition: rotate 0.3s;
    }
    .issue:hover { rotate: 0deg; }
    @media (width < 40rem) { .issue { rotate: 0deg; } }
    .issue-head {
      display: flex;
      justify-content: space-between;
      color: var(--ink-faint);
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      padding-block-end: 0.6rem;
      border-block-end: 1px dashed var(--line);
    }
    ol { list-style: none; padding: 0; margin: 0; }
    li {
      display: grid;
      grid-template-columns: 4rem 1fr;
      grid-template-areas: "lap label" "lap body";
      gap: 0.15rem var(--space-s);
      padding-block: 0.8rem;
      border-block-end: 1px solid var(--line);
    }
    li:last-child { border: 0; padding-block-end: 0; }
    .lap { grid-area: lap; color: var(--accent); text-transform: uppercase; font-size: 0.75rem; padding-block-start: 0.2em; }
    strong { grid-area: label; font-family: var(--font-display); font-stretch: 75%; font-weight: 900; text-transform: uppercase; font-size: var(--step-1); }
    .body { grid-area: body; color: var(--ink-muted); font-family: var(--font-sans); }
  }
</style>
