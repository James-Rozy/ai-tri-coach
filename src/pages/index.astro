---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PromptCard from '../components/PromptCard.astro';
import Signup from '../components/Signup.astro';
import SeasonLine from '../components/SeasonLine.astro';
import WatchFacePreview from '../components/watchface/WatchFacePreview';
import { watchFaces } from '../data/watchFaces';
import finishChute from '../assets/photos/finish-chute.jpg';

const prompts = (await getCollection('prompts', ({ data }) => data.tier === 'free')).sort(
  (a, b) => a.data.order - b.data.order,
);
const updates = (await getCollection('updates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = updates[0];
const shortDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

// The site's sections as a timing board: each one is a split on the way to the finish (the newsletter).
const course = [
  { split: '01', name: 'Guide', href: '/guide/', what: 'Set up your own AI coach', meta: `${prompts.length} prompts · free`, color: 'var(--swim)' },
  { split: '02', name: 'My progress', href: '/progress/', what: 'My Ironman build, in public', meta: `Updated ${shortDate(latest.data.date)}`, color: 'var(--bike)' },
  { split: '03', name: 'Watch faces', href: '/watch-faces/', what: 'Custom faces for your watch', meta: `${watchFaces.length} for Garmin`, color: 'var(--run)' },
  { split: '04', name: 'About', href: '/about/', what: 'Why I’m building this', meta: 'The story', color: 'var(--trans)' },
];

const steps = [
  { n: '1', title: 'Tell it your goal', body: 'One prompt turns an AI chat into your coach: your sport, a goal you can measure, your history, the time you have.' },
  { n: '2', title: 'Give it your data', body: 'Connect your training app or upload an export. Scorecards and a notebook work too. Plans come from your numbers, not a template.' },
  { n: '3', title: 'Check in every week', body: 'It reads what you actually did, flags fatigue and missed sessions out loud, and tells you what it changed and why.' },
];
---
<Base title="Home">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@400;700&display=swap" />
  </Fragment>

  <section class="hero wrap">
    <div class="hero-copy stack">
      <p class="label">Self-coaching with AI · any sport</p>
      <h1>Build an AI coach that gets you to <span class="goal">your goal</span>.</h1>
      <p class="lede muted">
        Pick a goal you can measure. Split Decisions shows you how to set up an AI coach that plans from your own data,
        explains every call, and tells you when you’re slipping. It works for running, cycling, swimming, golf, or
        anything else with a number on it.
      </p>
      <div class="actions">
        <a class="button" href="/guide/">Start the free guide <span class="arrow" aria-hidden="true">→</span></a>
        <a class="button ghost" href="/newsletter/">Get the newsletter</a>
      </div>
    </div>

    <nav class="board mono" aria-label="What’s on Split Decisions">
      <div class="board-head"><span>Course map</span><span class="clock" aria-hidden="true"><span>00</span><i>:</i><span>00</span><i>:</i><span>00</span></span></div>
      <ol>
        {course.map((c, i) => (
          <li style={`--leg: ${c.color}; --i: ${i}`}>
            <a href={c.href}>
              <span class="split">{c.split}</span>
              <span class="name">{c.name}</span>
              <span class="what">{c.what}</span>
              <span class="meta">{c.meta}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
      <a class="fin" href="/newsletter/" style={`--i: ${course.length}`}>
        <span class="split">Fin</span>
        <span class="name">Newsletter</span>
        <span class="what">Every other Sunday</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </nav>
  </section>

  <script>
    // The board's race clock counts up from when the page opened.
    // A number changing isn't motion, so it ticks even with Reduce Motion on (only the colon blink stops).
    // Only the digits' text changes, so the scoped styles on the colons keep applying.
    const digits = document.querySelectorAll<HTMLElement>('.clock > span');
    if (digits.length === 3) {
      const start = Date.now();
      const pad = (n: number) => String(n).padStart(2, '0');
      const tick = () => {
        const s = Math.floor((Date.now() - start) / 1000);
        [Math.floor(s / 3600), Math.floor(s / 60) % 60, s % 60].forEach((n, i) => (digits[i].textContent = pad(n)));
      };
      setInterval(tick, 1000);
    }
  </script>

  <section class="wrap section stack" aria-labelledby="how-heading">
    <p class="label">How it works</p>
    <h2 id="how-heading">Three steps to your own coach</h2>
    <ol class="steps">
      {steps.map((s) => (
        <li>
          <span class="step-n mono" aria-hidden="true">{s.n}</span>
          <h3>{s.title}</h3>
          <p class="muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap section stack" aria-labelledby="guide-heading">
    <div class="section-head">
      <div class="stack">
        <p class="label">01 · The guide</p>
        <h2 id="guide-heading">Your coach, set up in four prompts</h2>
      </div>
      <a href="/guide/">Read the full guide <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <p class="muted">Copy them into your AI app in order. Each one comes with examples for different sports.</p>
    <div class="grid">
      {prompts.map((prompt) => <PromptCard prompt={prompt} />)}
    </div>
  </section>

  <section class="wrap section stack" aria-labelledby="progress-heading">
    <div class="section-head">
      <div class="stack">
        <p class="label">02 · My progress</p>
        <h2 id="progress-heading">I’m the test case</h2>
      </div>
      <a href="/progress/">Every update <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <p class="muted">
      I missed my goal at 70.3 Michigan, so I’m letting an AI coach me to a rematch and then my first Ironman. The
      plans, the data and the bad weeks all go up here.
    </p>
    <SeasonLine />
    <a class="latest" href={`/progress/#${latest.id}`}>
      <span class="mono latest-date">{shortDate(latest.data.date)} · {latest.data.phase}</span>
      <strong>{latest.data.title}</strong>
      <span class="muted">{latest.data.summary}</span>
    </a>
  </section>

  <section class="wrap section" aria-labelledby="watch-heading">
    <div class="watch">
      <div class="watch-preview">
        <WatchFacePreview client:visible controls={false} />
      </div>
      <div class="stack watch-copy">
        <p class="label">03 · Watch faces</p>
        <h2 id="watch-heading">Your training week, on your wrist</h2>
        <p class="muted">
          {watchFaces[0].name} is the face I wear every day: swim, bike and run rings that fill toward your weekly
          targets, an LCD panel for the time, and a countdown to race day. This one’s live, ticking in your time zone.
        </p>
        <p><a class="button" href="/watch-faces/">See the watch faces <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="about-heading">
    <div class="about">
      <figure>
        <Image
          src={finishChute}
          alt="James smiling as he runs down the finish chute at Ironman 70.3 Michigan"
          widths={[400, 700, 1000]}
          sizes="(width < 40rem) 100vw, 40vw"
        />
      </figure>
      <div class="stack">
        <p class="label">04 · About</p>
        <h2 id="about-heading">Hi, I’m James</h2>
        <p class="muted">
          I’m a frontend developer in Chicago, a former D1 water polo player, and an age-group triathlete who came up 23
          minutes short of his goal. Split Decisions is what I’m building on the way back.
        </p>
        <p><a href="/about/">Read the story <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

  <div class="wrap section">
    <Signup />
  </div>
</Base>

<style>
  @layer components {
    .hero {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
      gap: var(--space-l);
      align-items: center;
      padding-block: var(--space-l) var(--space-xl);
    }
    .hero-copy { --stack-gap: var(--space-m); }
    .goal {
      color: var(--accent);
      background: linear-gradient(var(--accent), var(--accent)) left bottom / 100% 0.08em no-repeat;
    }
    @media (prefers-reduced-motion: no-preference) {
      .goal { animation: underline 0.8s 0.6s ease-out both; }
    }
    @keyframes underline { from { background-size: 0 0.08em; } }
    .lede { font-size: var(--step-1); line-height: 1.5; }
    .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s); }
    .actions .button { flex: 1 1 auto; justify-content: center; }
    @media (width >= 40rem) { .actions .button { flex: none; } }

    /* Timing board: each section of the site is a split. */
    .board {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: var(--space-m);
      display: grid;
      gap: 0.4rem;
      font-size: var(--step--1);
      box-shadow: 0 2rem 4rem rgb(0 0 0 / 0.35);
    }
    .board-head {
      display: flex;
      justify-content: space-between;
      color: var(--ink-faint);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.75rem;
      padding-block-end: 0.5rem;
      border-block-end: 1px dashed var(--line);
    }
    .clock { color: var(--accent); }
    .clock i { font-style: normal; }
    @media (prefers-reduced-motion: no-preference) {
      .clock i { animation: blink 1s steps(2) infinite; }
    }
    @keyframes blink { 50% { opacity: 0.2; } }
    .board ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.4rem; }
    .board a {
      display: grid;
      grid-template-columns: 2.5rem 1fr auto;
      grid-template-areas: "split name arrow" "split what meta";
      column-gap: 0.75rem;
      align-items: baseline;
      padding: 0.7rem 0.8rem 0.7rem 0.7rem;
      border-radius: 6px;
      border-inline-start: 3px solid var(--leg, var(--accent));
      text-decoration: none;
      background: linear-gradient(90deg, var(--accent-dim), transparent) left / 0% 100% no-repeat;
      transition: background-size 0.35s ease-out;
    }
    .board a:hover, .board a:focus-visible { background-size: 100% 100%; }
    .split { grid-area: split; color: var(--ink-faint); text-transform: uppercase; }
    .name { grid-area: name; font-family: var(--font-display); font-weight: 900; font-stretch: 75%; font-size: var(--step-1); text-transform: uppercase; line-height: 1.1; }
    .what { grid-area: what; color: var(--ink-muted); font-family: var(--font-sans); }
    .meta { grid-area: meta; color: var(--ink-faint); text-align: end; white-space: nowrap; font-size: 0.75rem; }
    .board .arrow { grid-area: arrow; justify-self: end; color: var(--leg, var(--accent)); }
    .fin { --leg: var(--accent); margin-block-start: 0.4rem; border-block-start: 1px dashed var(--line); grid-template-areas: "split name arrow" "split what arrow" !important; }
    .fin .name { color: var(--accent); }

    /* Splits come in one after another, like a results board updating. */
    @media (prefers-reduced-motion: no-preference) {
      .board li, .fin { animation: split-in 0.45s calc(0.15s + var(--i) * 0.09s) cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    }
    @keyframes split-in { from { opacity: 0; translate: -0.75rem 0; clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }

    .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-s); }
    .section-head > a, .stack > p > a:not(.button) { display: inline-block; padding-block: 0.6rem; text-decoration: none; color: var(--accent); font-weight: 600; }

    .steps {
      list-style: none;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
      gap: var(--space-s);
      counter-reset: step;
    }
    .steps li {
      position: relative;
      display: grid;
      gap: 0.5rem;
      align-content: start;
      padding: var(--space-m);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      overflow: hidden;
    }
    .step-n {
      position: absolute;
      inset-block-start: -0.15em;
      inset-inline-end: 0.1em;
      font-size: clamp(4rem, 3rem + 4vw, 6rem);
      line-height: 1;
      font-weight: 600;
      color: var(--line);
      pointer-events: none;
    }
    .steps h3, .steps p { position: relative; }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
      gap: var(--space-s);
    }

    .latest {
      display: grid;
      gap: 0.3rem;
      padding: var(--space-m);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      text-decoration: none;
      transition: border-color 0.15s;
    }
    .latest:hover { border-color: var(--accent); }
    .latest strong { font-size: var(--step-1); line-height: 1.2; }
    .latest-date { color: var(--accent); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }

    .watch {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
      gap: var(--space-l);
      align-items: center;
      padding: var(--space-l) var(--space-m);
      border-radius: calc(var(--radius) * 2);
      background:
        radial-gradient(circle at 25% 50%, oklch(80% 0.17 75 / 0.12), transparent 60%),
        var(--surface);
      border: 1px solid var(--line);
    }
    .watch-preview { min-inline-size: 0; }
    .watch-copy { --stack-gap: var(--space-s); }

    .about {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
      gap: var(--space-l);
      align-items: center;
    }
    .about figure { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); border: 1px solid var(--line); }
    .about img { inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 72% 30%; }
  }
</style>
